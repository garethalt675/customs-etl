{
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "environments": [
    {
      "environment_key": "Default",
      "spec": {
        "environment_version": "5"
      }
    }
  ],
  "format": "MULTI_TASK",
  "git_source": {
    "git_branch": "main",
    "git_provider": "gitHub",
    "git_url": "https://github.com/garethalt675/customs-etl"
  },
  "max_concurrent_runs": 1,
  "name": "etl data customs (curated)",
  "performance_target": "PERFORMANCE_OPTIMIZED",
  "queue": {
    "enabled": true
  },
  "tasks": [
    {
      "disabled": false,
      "email_notifications": {},
      "environment_key": "Default",
      "notebook_task": {
        "notebook_path": "notebooks/4_Curated/03_build_dim_province",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS",
      "task_key": "dim_province",
      "timeout_seconds": 0,
      "webhook_notifications": {}
    },
    {
      "depends_on": [
        {
          "task_key": "dim_province"
        }
      ],
      "disabled": false,
      "email_notifications": {},
      "environment_key": "Default",
      "notebook_task": {
