      "timeout_seconds": 0,
      "webhook_notifications": {}
    },
    {
      "depends_on": [
        {
          "task_key": "build_curated"
        }
      ],
      "disabled": false,
      "email_notifications": {},
      "environment_key": "Default",
      "notebook_task": {
        "notebook_path": "notebooks/4_Curated/05_translate_dimensions",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS",
      "task_key": "translate_dims",
      "timeout_seconds": 0,
      "webhook_notifications": {}
    },
    {
      "depends_on": [
        {
          "task_key": "translate_dims"
        }
      ],
      "disabled": false,
      "email_notifications": {},
      "environment_key": "Default",
      "notebook_task": {
        "notebook_path": "notebooks/4_Curated/01_build_curated_trade_statistics",
        "source": "GIT"
