{
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "environments": [
    {
      "environment_key": "Default",
      "spec": {
        "environment_version": "5"
      }
    }
  ],
  "format": "MULTI_TASK",
  "git_source": {
    "git_branch": "main",
    "git_provider": "gitHub",
    "git_url": "https://github.com/garethalt675/customs-etl"
  },
  "max_concurrent_runs": 1,
  "name": "etl data customs (fdi)",
  "performance_target": "PERFORMANCE_OPTIMIZED",
  "queue": {
    "enabled": true
  },
  "tasks": [
    {
      "disabled": false,
      "email_notifications": {},
      "environment_key": "Default",
      "notebook_task": {
        "notebook_path": "notebooks/IMEX Goods by FDI Monthly Data/0_Update_FDI_URL_Table",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS",
      "task_key": "url_crawl",
      "timeout_seconds": 0,
      "webhook_notifications": {}
    },
    {
      "depends_on": [
        {
          "task_key": "url_crawl"
        }
      ],
      "disabled": false,
      "email_notifications": {},
      "environment_key": "Default",
      "notebook_task": {
        "notebook_path": "notebooks/IMEX Goods by FDI Monthly Data/1_Download_FDI_Documents",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS",
      "task_key": "download_docs",
      "timeout_seconds": 0,
      "webhook_notifications": {}
    },
    {
      "depends_on": [
        {
          "task_key": "download_docs"
        }
      ],
      "disabled": false,
      "email_notifications": {},
      "environment_key": "Default",
      "notebook_task": {
        "notebook_path": "notebooks/IMEX Goods by FDI Monthly Data/2_Parse_FDI_Documents",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS",
      "task_key": "parsed_docs",
      "timeout_seconds": 0,
      "webhook_notifications": {}
    },
    {
      "depends_on": [
        {
          "task_key": "parsed_docs"
        }
      ],
      "disabled": false,
      "email_notifications": {},
      "environment_key": "Default",
      "notebook_task": {
        "notebook_path": "notebooks/IMEX Goods by FDI Monthly Data/3_Extract_FDI_Statistics",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS",
      "task_key": "extract_data",
      "timeout_seconds": 0
    }
  ],
  "timeout_seconds": 0,
  "webhook_notifications": {}
}
